<UserControl x:Class="WorkChatMini.ReadingHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Background="{StaticResource ShellCanvasBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="BrowserStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Compact accessible fields and controls; real data remains in ReadingLibraryStore. -->
            <Style x:Key="ReadingFieldStyle" TargetType="TextBox">
                <Setter Property="Height" Value="36"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="11,7"/>
                <Setter Property="Foreground" Value="{StaticResource ShellTextBrush}"/>
                <Setter Property="CaretBrush" Value="White"/>
                <Setter Property="Background" Value="{StaticResource ShellSurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ShellLineBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="FieldBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource ShellAccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ReadingFilterStyle" TargetType="Button">
                <Setter Property="Height" Value="32"/>
                <Setter Property="MinWidth" Value="58"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Foreground" Value="{StaticResource ShellMutedBrush}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="{StaticResource ShellSurfaceBrush}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="FilterBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="FilterBorder" Property="Background" Value="{StaticResource ShellHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="FilterBorder" Property="BorderBrush" Value="{StaticResource ShellAccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ReadingProgressBarStyle" TargetType="ProgressBar">
                <Setter Property="Height" Value="4"/>
                <Setter Property="Background" Value="#3A4845"/>
                <Setter Property="Foreground" Value="{StaticResource ShellAccentBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid x:Name="PART_Track" Height="4">
                                <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                        CornerRadius="2" HorizontalAlignment="Left"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- One editorial workspace: actions near their content, no ornamental cards. -->
    <Border Background="{StaticResource ShellCanvasBrush}">
        <!-- Whole page scrolls vertically even in the minimum-size WorkChat window. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,15,16,12">

            <!-- Heading and actions stack instead of clipping on narrow windows. -->
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="THE READING DESK" Foreground="{StaticResource ShellAccentBrush}"
                           FontSize="10" FontWeight="SemiBold"/>
                <TextBlock Text="Reading library" Foreground="{StaticResource ShellTextBrush}"
                           FontSize="24" FontWeight="SemiBold" Margin="0,4,0,10"/>
                <WrapPanel Orientation="Horizontal">
                    <Button x:Name="ToggleAddReadingButton" Style="{StaticResource BrowserQuickLaunchButtonStyle}"
                            Content="+ Add book" Height="34" Margin="0,0,6,4" Padding="12,6"
                            Background="{StaticResource ShellAccentSoftBrush}"/>
                    <Button x:Name="CloseReadingButton" Style="{StaticResource BrowserQuickLaunchButtonStyle}"
                            Height="34" Content="Back to web" Margin="0,0,6,4" Padding="12,6"
                            ToolTip="Return to web browser"/>
                </WrapPanel>
            </StackPanel>

            <!-- Reading tabs are metadata only; no extra WebView2 is started. -->
            <Border BorderBrush="{StaticResource ShellLineBrush}"
                    BorderThickness="0,0,0,1" Margin="0,0,0,13" Padding="0,0,0,8">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ReadingOpenTabsInner" Orientation="Horizontal"/>
                </ScrollViewer>
            </Border>

            <!-- Compact horizontally scrollable source/actions strip, rather than wrapping 5 rows. -->
            <ScrollViewer Margin="0,0,0,12" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="MangaDexReadingButton" Style="{StaticResource BrowserQuickLaunchButtonStyle}"
                            Content="MangaDex ↗" Tag="https://mangadex.org/" Height="31" Margin="0,0,6,3" Padding="10,5"/>
                    <Button x:Name="WebnovelReadingButton" Style="{StaticResource BrowserQuickLaunchButtonStyle}"
                            Content="Webnovel ↗" Tag="https://www.webnovel.com/" Height="31" Margin="0,0,6,3" Padding="10,5"/>
                    <Button x:Name="HakoReadingButton" Style="{StaticResource BrowserQuickLaunchButtonStyle}"
                            Content="Hako / DocLN ↗" Tag="https://docln.net/" Height="31" Margin="0,0,6,3" Padding="10,5"/>
                    <Button x:Name="SaveCurrentReadingButton" Style="{StaticResource BrowserQuickLaunchButtonStyle}"
                            Content="Save page" Height="31" Margin="0,0,6,3" Padding="10,5"/>
                    <Button x:Name="CheckReadingUpdatesButton" Style="{StaticResource BrowserQuickLaunchButtonStyle}"
                            Content="Check chapters" Height="31" Margin="0,0,0,3" Padding="10,5"
                            ToolTip="Check up to eight MangaDex series; other websites are not scanned"/>
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="ReadingAddForm" Visibility="Collapsed"
                    Background="{StaticResource ShellSurfaceBrush}" BorderBrush="{StaticResource ShellLineBrush}"
                    BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,0,0,13">
                <StackPanel>
                    <TextBlock x:Name="ReadingEditorHeading" Text="Save a story from any website"
                               Foreground="{StaticResource ShellTextBrush}" FontSize="13"
                               FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="TITLE" Foreground="{StaticResource ShellMutedBrush}" FontSize="10" Margin="0,0,0,5"/>
                    <TextBox x:Name="ReadingTitleInputInner" Style="{StaticResource ReadingFieldStyle}" Margin="0,0,0,10"/>
                    <TextBlock Text="BOOK OR CHAPTER URL" Foreground="{StaticResource ShellMutedBrush}" FontSize="10" Margin="0,0,0,5"/>
                    <TextBox x:Name="ReadingUrlInputInner" Style="{StaticResource ReadingFieldStyle}" Margin="0,0,0,11"/>
                    <WrapPanel HorizontalAlignment="Left">
                        <Button x:Name="AddReadingButton" Content="Save to library"
                                Style="{StaticResource BrowserQuickLaunchButtonStyle}" Padding="12,6" Margin="0,0,6,0"
                                Background="{StaticResource ShellAccentSoftBrush}"/>
                        <Button x:Name="CancelReadingButton" Content="Cancel"
                                Style="{StaticResource BrowserQuickLaunchButtonStyle}" Padding="12,6" Margin="0"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border x:Name="ReadingContinuePanel" Visibility="Collapsed" Margin="0,0,0,16"
                    Background="{StaticResource ShellAccentSoftBrush}" CornerRadius="11" Padding="12">
                <StackPanel>
                    <TextBlock Text="PICK UP WHERE YOU LEFT OFF" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource ShellAccentBrush}" Margin="0,0,0,5"/>
                    <TextBlock x:Name="ReadingContinueTitle" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource ShellTextBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ReadingContinueMeta" Foreground="{StaticResource ShellMutedBrush}"
                               TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,3,0,9"/>
                    <ProgressBar x:Name="ReadingContinueProgress" Minimum="0" Maximum="100" Value="0"
                                 Style="{StaticResource ReadingProgressBarStyle}" Margin="0,0,0,11"/>
                    <Button x:Name="ContinueReadingButton" Content="Continue reading  ›"
                            Style="{StaticResource BrowserQuickLaunchButtonStyle}" HorizontalAlignment="Left"
                            Height="34" Padding="12,6" Margin="0"/>
                </StackPanel>
            </Border>

            <StackPanel Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Your shelf" Foreground="{StaticResource ShellTextBrush}"
                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ReadingCountTextInner" Foreground="{StaticResource ShellMutedBrush}"
                               FontSize="11" VerticalAlignment="Center" Margin="9,1,0,0"/>
                </StackPanel>
                <TextBox x:Name="ReadingSearchInputInner" Style="{StaticResource ReadingFieldStyle}"
                         ToolTip="Search title or source" Margin="0,0,0,8"
                         AutomationProperties.Name="Search reading library"/>
                <WrapPanel Orientation="Horizontal">
                    <Button x:Name="ReadingFilterAll" Tag="All" Content="All" Style="{StaticResource ReadingFilterStyle}" Margin="0,0,5,5"/>
                    <Button x:Name="ReadingFilterCurrent" Tag="Reading" Content="Reading" Style="{StaticResource ReadingFilterStyle}" Margin="0,0,5,5"/>
                    <Button x:Name="ReadingFilterWaiting" Tag="Waiting" Content="Waiting" Style="{StaticResource ReadingFilterStyle}" Margin="0,0,5,5"/>
                    <Button x:Name="ReadingFilterFavorites" Tag="Favorites" Content="Favorites" Style="{StaticResource ReadingFilterStyle}" Margin="0,0,0,5"/>
                </WrapPanel>
            </StackPanel>

            <StackPanel>
                    <TextBlock x:Name="ReadingMessageTextInner" Foreground="#D9BE8F" TextWrapping="Wrap"
                               FontSize="11" Margin="4,3,4,8"/>
                    <StackPanel x:Name="ReadingShelfInner"/>
                    <Button x:Name="ReadingShowMoreButton" Content="Show more books"
                            Visibility="Collapsed" Height="34" HorizontalAlignment="Center"
                            Margin="0,12,0,18" Padding="15,6"
                            Style="{StaticResource BrowserQuickLaunchButtonStyle}"/>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
