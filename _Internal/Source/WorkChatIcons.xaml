<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- WorkChat original pixel-art PNGs, shipped as WPF resources; do not replace with vectors. -->
    <BitmapImage x:Key="MessengerPixelIcon" UriSource="pack://application:,,,/Assets/Icons/messenger.png"/>
    <BitmapImage x:Key="FacebookPixelIcon" UriSource="pack://application:,,,/Assets/Icons/facebook.png"/>
    <BitmapImage x:Key="YouTubePixelIcon" UriSource="pack://application:,,,/Assets/Icons/youtube.png"/>
    <BitmapImage x:Key="DiscordPixelIcon" UriSource="pack://application:,,,/Assets/Icons/discord.png"/>
    <BitmapImage x:Key="ZaloPixelIcon" UriSource="pack://application:,,,/Assets/Icons/zalo.png"/>
    <BitmapImage x:Key="WebPixelIcon" UriSource="pack://application:,,,/Assets/Icons/web.png"/>
    <BitmapImage x:Key="ReadingPixelIcon" UriSource="pack://application:,,,/Assets/Icons/reading.png"/>
</ResourceDictionary>
