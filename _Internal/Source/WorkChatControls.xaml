<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Native WPF GridSplitter with modern, discoverable hover/focus feedback. -->
    <Style x:Key="ModernSplitDividerStyle" TargetType="GridSplitter">
        <Setter Property="Background" Value="{StaticResource ShellLineBrush}"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="Focusable" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ShellAccentBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{StaticResource ShellAccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Quiet Workbench: 46 DIP hit target; original pixel PNGs remain unchanged. -->
    <Style x:Key="AppIconButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource ShellTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11"/>
                        <Border x:Name="ActiveMarker" Width="3" Height="20" CornerRadius="0,2,2,0"
                                Background="{StaticResource ShellAccentBrush}" HorizontalAlignment="Left"
                                Margin="-5,0,0,0" Visibility="Collapsed"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ShellHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ShellAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ShellAccentSoftBrush}"/>
                            <Setter TargetName="ActiveMarker" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="Active"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ShellAccentSoftBrush}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ShellAccentOutlineBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="Tag" Value="Sleeping"><Setter Property="Opacity" Value="0.48"/></Trigger>
                        <Trigger Property="Tag" Value="Hibernated"><Setter Property="Opacity" Value="0.3"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Premium Control Center: restrained layered surfaces, native focus feedback. -->
    <Style x:Key="SettingsNavButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="39"/>
        <Setter Property="Margin" Value="0,0,0,3"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            CornerRadius="10" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Selected">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource SettingsAccentSoftBrush}"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource SettingsAccentOutlineBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource SettingsIconBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="Selected"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource SettingsAccentSoftBrush}"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource SettingsAccentBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource SettingsAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SettingsFlyoutRowStyle" TargetType="Button">
        <Setter Property="Height" Value="53"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="Foreground" Value="{StaticResource ShellTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource SettingsPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SettingsStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Selected">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource SettingsAccentSoftBrush}"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource SettingsAccentOutlineBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource SettingsIconBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="Selected"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource SettingsAccentSoftBrush}"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource SettingsAccentBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource SettingsAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource SettingsAccentSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SettingsFlyoutSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Height" Value="57"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Foreground" Value="{StaticResource ShellTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource SettingsPanelBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="RowSurface" CornerRadius="11"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource SettingsStrokeBrush}" BorderThickness="1">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="51"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="10"
                                    Background="{StaticResource SettingsIconBrush}" HorizontalAlignment="Left">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                                           Foreground="{StaticResource ShellTextBrush}" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            <Border x:Name="Track" Grid.Column="2" Width="41" Height="24"
                                    Background="#43455B" BorderBrush="#666981" BorderThickness="1"
                                    CornerRadius="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse x:Name="Thumb" Fill="#D5D9EE" Width="18" Height="18"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource SettingsAccentBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource SettingsAccentBrush}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="#222039"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowSurface" Property="Background" Value="{StaticResource SettingsIconBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="RowSurface" Property="BorderBrush" Value="{StaticResource SettingsAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
