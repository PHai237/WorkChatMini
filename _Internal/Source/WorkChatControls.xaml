<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Native WPF GridSplitter with modern, discoverable hover/focus feedback. -->
    <Style x:Key="ModernSplitDividerStyle" TargetType="GridSplitter">
        <Setter Property="Background" Value="{StaticResource ShellLineBrush}"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="Focusable" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ShellAccentBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{StaticResource ShellAccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Figma compact rail, 46 DIP hit target; pixel PNGs are unchanged. -->
    <Style x:Key="AppIconButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource ShellTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"/>
                        <Border x:Name="ActiveMarker" Width="3" Height="24" CornerRadius="0,2,2,0"
                                Background="{StaticResource ShellAccentBrush}" HorizontalAlignment="Left"
                                Margin="-5,0,0,0" Visibility="Collapsed"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ShellHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ShellAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ShellAccentSoftBrush}"/>
                            <Setter TargetName="ActiveMarker" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Sleeping"><Setter Property="Opacity" Value="0.48"/></Trigger>
                        <Trigger Property="Tag" Value="Hibernated"><Setter Property="Opacity" Value="0.3"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Settings: one visual system for every row/page; never use the OS MenuItem popup. -->
    <Style x:Key="SettingsFlyoutRowStyle" TargetType="Button">
        <Setter Property="Height" Value="39"/>
        <Setter Property="Margin" Value="0,0"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="Foreground" Value="{StaticResource ShellTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource ShellHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource ShellAccentSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource ShellAccentSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Full-row toggle with a visible modern switch; no default WPF checkbox chrome. -->
    <Style x:Key="SettingsFlyoutSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Height" Value="58"/>
        <Setter Property="Margin" Value="0,0"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="Foreground" Value="{StaticResource ShellTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="RowSurface" CornerRadius="7" Background="{TemplateBinding Background}">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                            <Border x:Name="Track" Grid.Column="1" Width="36" Height="20"
                                    Background="#343B45" BorderBrush="#343B45" BorderThickness="1"
                                    CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse x:Name="Thumb" Fill="#A6ADBA" Width="16" Height="16"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource ShellAccentBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource ShellAccentBrush}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowSurface" Property="Background" Value="{StaticResource ShellHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="RowSurface" Property="Background" Value="{StaticResource ShellAccentSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
