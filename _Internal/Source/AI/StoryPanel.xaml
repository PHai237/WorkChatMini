<UserControl x:Class="WorkChatMini.StoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F0E0D" Foreground="#E8E0D0" FontFamily="Segoe UI"
             SizeChanged="StoryPanel_SizeChanged" PreviewKeyDown="StoryPanel_PreviewKeyDown">
    <UserControl.Resources>
        <!-- Figma Archive direction: near-black, warm parchment text, restrained brass accents. -->
        <SolidColorBrush x:Key="StoryBg" Color="#0F0E0D"/>
        <SolidColorBrush x:Key="StorySidebar" Color="#0C0B09"/>
        <SolidColorBrush x:Key="StorySurface" Color="#161412"/>
        <SolidColorBrush x:Key="StoryCard" Color="#1C1917"/>
        <SolidColorBrush x:Key="StoryPanel" Color="#201E1A"/>
        <SolidColorBrush x:Key="StoryAiMessage" Color="#18160E"/>
        <SolidColorBrush x:Key="StoryUserMessage" Color="#201C14"/>
        <SolidColorBrush x:Key="StoryComposer" Color="#161310"/>
        <SolidColorBrush x:Key="StoryBorder" Color="#26C8A84B"/>
        <SolidColorBrush x:Key="StoryDivider" Color="#18C8A84B"/>
        <SolidColorBrush x:Key="StoryText" Color="#E8E0D0"/>
        <SolidColorBrush x:Key="StorySub" Color="#9A8F74"/>
        <SolidColorBrush x:Key="StoryMuted" Color="#6B604D"/>
        <SolidColorBrush x:Key="StoryGhost" Color="#2E2820"/>
        <SolidColorBrush x:Key="StoryGold" Color="#C8A84B"/>
        <SolidColorBrush x:Key="StoryGoldDim" Color="#17C8A84B"/>
        <SolidColorBrush x:Key="StoryGoldBorder" Color="#3DC8A84B"/>
        <BitmapImage x:Key="StoryIconImage" UriSource="pack://application:,,,/WorkChatMini;component/Assets/Icons/story.png"/>

        <Style x:Key="StoryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource StorySub}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource StoryDivider}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#211D16"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#514425"/>
                                <Setter Property="Foreground" Value="#D1BC82"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#E4C96D"/>
                                <Setter Property="Foreground" Value="#F1D68D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.78"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StoryAccentButton" TargetType="Button" BasedOn="{StaticResource StoryButton}">
            <Setter Property="Background" Value="{StaticResource StoryGold}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StoryGold}"/>
            <Setter Property="Foreground" Value="#15120B"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="StoryDangerButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F2D5CF"/>
            <Setter Property="Background" Value="#4A2722"/>
            <Setter Property="BorderBrush" Value="#7A4138"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DangerChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DangerChrome" Property="Background" Value="#623129"/>
                                <Setter TargetName="DangerChrome" Property="BorderBrush" Value="#A65B4D"/>
                                <Setter Property="Foreground" Value="#FFF0EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.82"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarNavButton" TargetType="Button" BasedOn="{StaticResource StoryButton}">
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="ProjectListButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource StoryText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ProjectChrome" Background="{TemplateBinding Background}" CornerRadius="6"
                                SnapsToDevicePixels="True" ClipToBounds="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ProjectChrome" Property="Background" Value="#211D16"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ProjectChrome" Property="Background" Value="#2A2419"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuggestionChipButton" TargetType="Button" BasedOn="{StaticResource StoryButton}">
            <Setter Property="Background" Value="{StaticResource StoryGhost}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StoryDivider}"/>
            <Setter Property="Foreground" Value="{StaticResource StorySub}"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="ComposerToolButton" TargetType="Button" BasedOn="{StaticResource StoryButton}">
            <Setter Property="MinWidth" Value="58"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- Fully custom ComboBox so Windows light-theme chrome cannot leak into Story. -->
        <!-- Archive-themed scrollbars: slim, quiet, and consistent with the Story surface. -->
        <Style x:Key="StoryInvisibleRepeatButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="StoryVerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
            <Grid Width="9" Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource StoryInvisibleRepeatButton}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb MinHeight="28" Margin="2,2,1,2" Cursor="Hand">
                            <Thumb.Template>
                                <ControlTemplate TargetType="{x:Type Thumb}">
                                    <Border x:Name="ThumbChrome" Background="#5A4B2B" CornerRadius="4" Opacity="0.72"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ThumbChrome" Property="Background" Value="#8C7440"/>
                                            <Setter TargetName="ThumbChrome" Property="Opacity" Value="0.95"/>
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="ThumbChrome" Property="Background" Value="#C8A84B"/>
                                            <Setter TargetName="ThumbChrome" Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource StoryInvisibleRepeatButton}"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="StoryHorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
            <Grid Height="9" Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="False" Focusable="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Style="{StaticResource StoryInvisibleRepeatButton}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb MinWidth="28" Margin="2,2,2,1" Cursor="Hand">
                            <Thumb.Template>
                                <ControlTemplate TargetType="{x:Type Thumb}">
                                    <Border x:Name="ThumbChrome" Background="#5A4B2B" CornerRadius="4" Opacity="0.72"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ThumbChrome" Property="Background" Value="#8C7440"/>
                                            <Setter TargetName="ThumbChrome" Property="Opacity" Value="0.95"/>
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="ThumbChrome" Property="Background" Value="#C8A84B"/>
                                            <Setter TargetName="ThumbChrome" Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Style="{StaticResource StoryInvisibleRepeatButton}"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="9"/>
            <Setter Property="Template" Value="{StaticResource StoryVerticalScrollBarTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="9"/>
                    <Setter Property="Template" Value="{StaticResource StoryHorizontalScrollBarTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Discreet per-message actions: same visual language without a full toolbar. -->
        <Style x:Key="StoryInlineActionButton" TargetType="Button" BasedOn="{StaticResource StoryButton}">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource StoryMuted}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="StoryMessageCopyButton" TargetType="Button" BasedOn="{StaticResource StoryButton}">
            <Setter Property="Width" Value="27"/>
            <Setter Property="Height" Value="23"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="7,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource StoryMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="ToolTip" Value="Copy message"/>
        </Style>

        <Style x:Key="StoryCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{StaticResource StoryText}"/>
            <Setter Property="Background" Value="#241F18"/>
            <Setter Property="BorderBrush" Value="#66562B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,0,26,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent" BorderThickness="0">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><ContentPresenter/></ControlTemplate></ToggleButton.Template>
                                <Grid>
                                    <Border x:Name="ComboChrome" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"/>
                                    <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                                      HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    <TextBlock Text="⌄" Foreground="{StaticResource StoryGold}" FontSize="13"
                                               Margin="0,0,9,2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border MinWidth="180" Margin="0,4,0,0" Padding="4" Background="#171512"
                                        BorderBrush="#544725" BorderThickness="1" CornerRadius="7">
                                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto"><StackPanel IsItemsHost="True"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="#514425"/></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="{StaticResource StoryGoldBorder}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource StoryText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#292318"/><Setter TargetName="ItemChrome" Property="BorderBrush" Value="#5E4D28"/><Setter Property="Foreground" Value="#E1C77A"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#3A2D17"/><Setter TargetName="ItemChrome" Property="BorderBrush" Value="#C8A84B"/><Setter Property="Foreground" Value="#F0D680"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StoryTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource StoryText}"/>
            <Setter Property="Background" Value="#181511"/>
            <Setter Property="BorderBrush" Value="#514425"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="CaretBrush" Value="{StaticResource StoryGold}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputChrome" CornerRadius="9" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputChrome" Property="BorderBrush" Value="#756339"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputChrome" Property="BorderBrush" Value="#D8B84F"/>
                                <Setter TargetName="InputChrome" Property="Background" Value="#211C14"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StoryToggleChip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#C7B88F"/>
            <Setter Property="Background" Value="#211D17"/>
            <Setter Property="BorderBrush" Value="#5A4B2B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,7,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="#8B7436"/>
                                <Setter TargetName="ToggleChrome" Property="Background" Value="#2A2419"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleChrome" Property="Background" Value="#473916"/>
                                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="#D8B84F"/>
                                <Setter Property="Foreground" Value="#FFE08A"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InspectorSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource StoryGold}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource StoryBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="196"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="InspectorColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar mirrors the Figma Archive design, adapted to real Story Memory actions. -->
        <Border Grid.Column="0" Background="{StaticResource StorySidebar}" BorderBrush="{StaticResource StoryBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StoriesLabel" Text="STORIES" Margin="14,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource StoryMuted}" FontSize="9" FontWeight="SemiBold"/>
                    <Button x:Name="SidebarCollapseButton" Grid.Column="1" Content="‹" Width="30" Height="28" Margin="0,0,8,0"
                            Style="{StaticResource StoryButton}" BorderThickness="0" FontSize="17" ToolTip="Collapse story sidebar"
                            Click="SidebarCollapseButton_Click"/>
                    <Border VerticalAlignment="Bottom" Height="1" Background="{StaticResource StoryDivider}" Grid.ColumnSpan="2"/>
                </Grid>

                <Button x:Name="NewProjectButton" Grid.Row="1" Margin="8,10,8,4" Style="{StaticResource StoryButton}"
                        Background="{StaticResource StoryGoldDim}" BorderBrush="{StaticResource StoryGoldBorder}" Foreground="{StaticResource StoryGold}"
                        Click="NewProjectButton_Click" ToolTip="Create a new story">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="＋" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NewStorySidebarText" Grid.Column="1" Text="New Story" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <Grid Grid.Row="3" Margin="8,10,8,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="ProjectsLabel" Text="YOUR STORIES" Foreground="{StaticResource StoryMuted}" FontSize="9" FontWeight="SemiBold" Margin="6,0,0,7" Visibility="Collapsed"/>
                    <ScrollViewer x:Name="ProjectsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                        <StackPanel x:Name="ProjectsListPanel"/>
                    </ScrollViewer>
                    <ComboBox x:Name="ProjectBox" Visibility="Collapsed" SelectionChanged="ProjectBox_SelectionChanged"/>
                    <TextBlock x:Name="SingleProjectText" Visibility="Collapsed"/>
                    <TextBlock x:Name="CurrentProjectGenreText" Visibility="Collapsed"/>
                    <TextBlock x:Name="CurrentProjectMetaText" Visibility="Collapsed"/>
                    <WrapPanel x:Name="GenreChipsPanel" Visibility="Collapsed"/>
                </Grid>

                <StackPanel x:Name="StoryNavPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,6,0,0">
                    <TextBlock Text="TOOLS" Foreground="{StaticResource StoryMuted}" FontSize="9" FontWeight="SemiBold" Margin="14,2,0,5"/>
                    <Button x:Name="CharactersNavButton" Tag="Characters" Style="{StaticResource SidebarNavButton}" Click="MemoryNav_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="♙" Foreground="{StaticResource StoryMuted}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CharactersNavText" Grid.Column="1" Text="Characters" FontSize="12" VerticalAlignment="Center"/>
                            <Border x:Name="CharactersCountBadge" Grid.Column="2" Background="{StaticResource StoryGoldDim}" BorderBrush="{StaticResource StoryGoldBorder}" BorderThickness="1" CornerRadius="9" Padding="6,1">
                                <TextBlock x:Name="CharactersCountText" Foreground="{StaticResource StoryGold}" FontSize="10"/>
                            </Border>
                        </Grid>
                    </Button>
                    <Button x:Name="CanonNavButton" Tag="Canon" Style="{StaticResource SidebarNavButton}" Click="MemoryNav_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="◫" Foreground="{StaticResource StoryMuted}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CanonNavText" Grid.Column="1" Text="Canon" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button x:Name="TimelineNavButton" Tag="Timeline" Style="{StaticResource SidebarNavButton}" Click="MemoryNav_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="◷" Foreground="{StaticResource StoryMuted}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TimelineNavText" Grid.Column="1" Text="Timeline" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button x:Name="LoreNavButton" Tag="World / Lore" Style="{StaticResource SidebarNavButton}" Click="MemoryNav_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="⌑" Foreground="{StaticResource StoryMuted}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LoreNavText" Grid.Column="1" Text="Lore" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button x:Name="ThreadsNavButton" Tag="Open Threads" Style="{StaticResource SidebarNavButton}" Click="MemoryNav_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="⌁" Foreground="{StaticResource StoryMuted}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ThreadsNavText" Grid.Column="1" Text="Threads" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button x:Name="ArcsNavButton" Tag="Story Arcs" Style="{StaticResource SidebarNavButton}" Click="MemoryNav_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="◌" Foreground="{StaticResource StoryMuted}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ArcsNavText" Grid.Column="1" Text="Arcs" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button x:Name="ResearchNavButton" Tag="Research" Visibility="Collapsed" Style="{StaticResource SidebarNavButton}" Click="MemoryNav_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="⌕" Foreground="{StaticResource StoryMuted}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ResearchNavText" Grid.Column="1" Text="Research" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button x:Name="IdeasNavButton" Tag="Ideas" Style="{StaticResource SidebarNavButton}" Click="MemoryNav_Click" ToolTip="Ideas agreed during Chat, not canon">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="✧" Foreground="{StaticResource StoryMuted}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock x:Name="IdeasNavText" Grid.Column="1" Text="Creative Ideas" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button x:Name="SceneCompassNavButton" Tag="Scene Compass" Style="{StaticResource SidebarNavButton}" Click="MemoryNav_Click" ToolTip="Recent committed chapters and possible writing direction">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="◈" Foreground="{StaticResource StoryMuted}" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SceneCompassNavText" Grid.Column="1" Text="Scene Compass" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button x:Name="MemoryNavButton" Tag="Overview" Style="{StaticResource SidebarNavButton}" Click="MemoryNav_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="✦" Foreground="{StaticResource StoryMuted}" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="MemoryNavText" Grid.Column="1" Text="Memory" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Border Height="1" Background="{StaticResource StoryDivider}" Margin="14,8,14,7"/>
                    <Button x:Name="SettingsNavButton" Tag="Settings" Style="{StaticResource SidebarNavButton}" Click="ProjectSettingsButton_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="⚙" Foreground="{StaticResource StoryMuted}" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SettingsNavText" Grid.Column="1" Text="Story Settings" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main story workspace. -->
        <Grid Grid.Column="1" Background="{StaticResource StoryBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <ScrollViewer x:Name="ChatScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              ScrollChanged="ChatScroll_ScrollChanged" Padding="34,63,34,8">
                    <StackPanel x:Name="MessagesPanel" MaxWidth="900" HorizontalAlignment="Center"/>
                </ScrollViewer>
                <!-- Search the entire conversation, including messages outside the 60-bubble visual window. -->
                <Border x:Name="ConversationSearchToolbar" Visibility="Collapsed" VerticalAlignment="Top"
                        HorizontalAlignment="Stretch" MaxWidth="650" Margin="18,8,24,0" Padding="8,5"
                        Background="{StaticResource StorySurface}" BorderBrush="{StaticResource StoryBorder}"
                        BorderThickness="1" CornerRadius="9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ConversationSearchBox" Style="{StaticResource StoryTextBox}"
                                 MinWidth="90" Height="30" MaxLength="120" Padding="8,4"
                                 ToolTip="Find messages across the whole current Story conversation"
                                 TextChanged="ConversationSearchBox_TextChanged" KeyDown="ConversationSearchBox_KeyDown"/>
                        <Button x:Name="ConversationSearchButton" Grid.Column="1" Content="Find" Margin="5,0,0,0"
                                Style="{StaticResource StoryButton}" Padding="8,4" MinHeight="30" Click="ConversationSearchButton_Click"/>
                        <Button x:Name="ConversationSearchPrevious" Grid.Column="2" Content="↑" Margin="5,0,0,0"
                                ToolTip="Previous match" Style="{StaticResource StoryButton}" Padding="9,4" MinHeight="30"
                                Click="ConversationSearchPrevious_Click"/>
                        <Button x:Name="ConversationSearchNext" Grid.Column="3" Content="↓" Margin="3,0,0,0"
                                ToolTip="Next match" Style="{StaticResource StoryButton}" Padding="9,4" MinHeight="30"
                                Click="ConversationSearchNext_Click"/>
                        <TextBlock x:Name="ConversationSearchCount" Grid.Column="4" MinWidth="72" Margin="8,0,0,0"
                                   VerticalAlignment="Center" TextAlignment="Center" FontSize="10.5"
                                   Foreground="{StaticResource StorySub}"/>
                    </Grid>
                </Border>
                <Button x:Name="JumpToLatestButton" Content="↓  Latest messages" Visibility="Collapsed"
                        Style="{StaticResource StoryButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,26,18" Padding="13,8" Click="JumpToLatestButton_Click"
                        ToolTip="Return to recent messages and release older chat bubbles"/>

                <Grid x:Name="EmptyState">
                    <!-- No-project state: only one New Story action, centered as requested. -->
                    <StackPanel x:Name="NoProjectState" HorizontalAlignment="Center" VerticalAlignment="Center" Width="430">
                        <Border Width="68" Height="68" CornerRadius="18" Background="{StaticResource StoryGoldDim}"
                                BorderBrush="{StaticResource StoryGoldBorder}" BorderThickness="1" HorizontalAlignment="Center">
                            <Image Source="{StaticResource StoryIconImage}" Width="46" Height="46" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True"/>
                        </Border>
                        <TextBlock Text="Begin a new story." Foreground="{StaticResource StoryText}" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,20,0,0"/>
                        <TextBlock Text="Start with a rough idea. Chat with Gemini, agree on directions together, then write chapter one when you feel ready."
                                   Foreground="{StaticResource StorySub}" FontSize="13.5" LineHeight="22" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" MaxWidth="390" Margin="0,10,0,0"/>
                        <Button x:Name="EmptyStateNewStoryButton" Content="＋  New Story" Width="140" Height="42" Margin="0,25,0,0"
                                Style="{StaticResource StoryAccentButton}" Click="NewProjectButton_Click"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0" Opacity="0.45">
                            <Border Width="52" Height="1" Background="{StaticResource StoryGold}" VerticalAlignment="Center"/>
                            <TextBlock Text="✦" Foreground="{StaticResource StoryGold}" FontSize="12" Margin="14,0"/>
                            <Border Width="52" Height="1" Background="{StaticResource StoryGold}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Chat to discover your world · Keep ideas · Continue when ready"
                                   Foreground="{StaticResource StoryMuted}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>

                    <!-- Existing project with no conversation yet. -->
                    <StackPanel x:Name="ProjectWelcomeState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="860">
                        <TextBlock x:Name="ProjectWelcomeTitle" Foreground="{StaticResource StoryText}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="What would you like to work on?" Foreground="{StaticResource StorySub}" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <WrapPanel HorizontalAlignment="Center" Margin="0,28,0,0">
                            <Button Tag="ContinueStory" Width="146" Height="126" Margin="5" Style="{StaticResource StoryButton}" Background="{StaticResource StoryGoldDim}" BorderBrush="{StaticResource StoryGoldBorder}" Click="SuggestionCard_Click">
                                <StackPanel HorizontalAlignment="Left"><Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource StoryGoldDim}" BorderBrush="{StaticResource StoryGoldBorder}" BorderThickness="1"><TextBlock Text="▶" Foreground="{StaticResource StoryGold}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Continue Story" Foreground="{StaticResource StoryText}" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="Let AI choose the next beat and remember it" Foreground="{StaticResource StoryMuted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                            </Button>
                            <Button Tag="DraftScene" Width="146" Height="126" Margin="5" Style="{StaticResource StoryButton}" Background="{StaticResource StoryCard}" Click="SuggestionCard_Click">
                                <StackPanel HorizontalAlignment="Left"><Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource StoryGoldDim}" BorderBrush="{StaticResource StoryGoldBorder}" BorderThickness="1"><TextBlock Text="✎" Foreground="{StaticResource StoryGold}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Draft Scene" Foreground="{StaticResource StoryText}" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="Write a new scene with your characters" Foreground="{StaticResource StoryMuted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                            </Button>
                            <Button Tag="PlanChapter" Width="146" Height="126" Margin="5" Style="{StaticResource StoryButton}" Background="{StaticResource StoryCard}" Click="SuggestionCard_Click">
                                <StackPanel HorizontalAlignment="Left"><Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource StoryGoldDim}" BorderBrush="{StaticResource StoryGoldBorder}" BorderThickness="1"><TextBlock Text="◫" Foreground="{StaticResource StoryGold}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Plan Chapter" Foreground="{StaticResource StoryText}" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="Structure the arc of your next chapter" Foreground="{StaticResource StoryMuted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                            </Button>
                            <Button Tag="BuildCharacter" Width="146" Height="126" Margin="5" Style="{StaticResource StoryButton}" Background="{StaticResource StoryCard}" Click="SuggestionCard_Click">
                                <StackPanel HorizontalAlignment="Left"><Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource StoryGoldDim}" BorderBrush="{StaticResource StoryGoldBorder}" BorderThickness="1"><TextBlock Text="♙" Foreground="{StaticResource StoryGold}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Build Character" Foreground="{StaticResource StoryText}" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="Develop a character profile or arc" Foreground="{StaticResource StoryMuted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                            </Button>
                            <Button Tag="CheckContinuity" Width="146" Height="126" Margin="5" Style="{StaticResource StoryButton}" Background="{StaticResource StoryCard}" Click="SuggestionCard_Click">
                                <StackPanel HorizontalAlignment="Left"><Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource StoryGoldDim}" BorderBrush="{StaticResource StoryGoldBorder}" BorderThickness="1"><TextBlock Text="⌁" Foreground="{StaticResource StoryGold}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Check Continuity" Foreground="{StaticResource StoryText}" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="Verify story logic against your canon" Foreground="{StaticResource StoryMuted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                            </Button>
                            <Button Tag="ExpandLore" Width="146" Height="126" Margin="5" Style="{StaticResource StoryButton}" Background="{StaticResource StoryCard}" Click="SuggestionCard_Click">
                                <StackPanel HorizontalAlignment="Left"><Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource StoryGoldDim}" BorderBrush="{StaticResource StoryGoldBorder}" BorderThickness="1"><TextBlock Text="⌑" Foreground="{StaticResource StoryGold}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Expand Lore" Foreground="{StaticResource StoryText}" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="Deepen your world's history and rules" Foreground="{StaticResource StoryMuted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                            </Button>
                            <Button Tag="ReviseCanon" Width="146" Height="126" Margin="5" Style="{StaticResource StoryButton}" Background="{StaticResource StoryCard}" Click="SuggestionCard_Click">
                                <StackPanel HorizontalAlignment="Left"><Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource StoryGoldDim}" BorderBrush="{StaticResource StoryGoldBorder}" BorderThickness="1"><TextBlock Text="↺" Foreground="{StaticResource StoryGold}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Revise Canon" Foreground="{StaticResource StoryText}" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="Correct or retcon an established fact safely" Foreground="{StaticResource StoryMuted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                            </Button>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0" Opacity="0.38">
                            <Border Width="58" Height="1" Background="{StaticResource StoryGold}" VerticalAlignment="Center"/>
                            <TextBlock Text="✦" Foreground="{StaticResource StoryGold}" FontSize="11" Margin="12,0"/>
                            <Border Width="58" Height="1" Background="{StaticResource StoryGold}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="NewStoryEditor" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,28">
                    <Border MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{StaticResource StorySurface}"
                            BorderBrush="#5B4C27" BorderThickness="1" CornerRadius="16" Padding="28">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="50" Height="50" CornerRadius="12" Background="{StaticResource StoryGoldDim}" BorderBrush="{StaticResource StoryGoldBorder}" BorderThickness="1">
                                    <Image Source="{StaticResource StoryIconImage}" Width="34" Height="34" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>
                                <StackPanel Margin="14,1,0,0">
                                    <TextBlock Text="Create a new story" Foreground="{StaticResource StoryText}" FontSize="21" FontWeight="SemiBold"/>
                                    <TextBlock Text="Give it a title, then develop everything else naturally with Gemini." Foreground="{StaticResource StorySub}" FontSize="12" Margin="0,5,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="TITLE" Style="{StaticResource InspectorSectionTitle}" Margin="0,24,0,8"/>
                            <TextBox x:Name="NewStoryTitleBox" Style="{StaticResource StoryTextBox}" Height="42"/>
                            <TextBlock Text="Start with a title. Characters, genres and plot can all develop later through Chat."
                                       Foreground="{StaticResource StorySub}" FontSize="11.5" Margin="0,12,0,0" TextWrapping="Wrap"/>
                            <Button Content="＋  Customize genres &amp; tags (optional)" HorizontalAlignment="Left" Margin="0,16,0,0"
                                    Style="{StaticResource StoryButton}" Click="ToggleNewStoryGenres_Click"/>
                            <StackPanel x:Name="NewStoryGenresPanel" Visibility="Collapsed">
                                <TextBlock Text="CORE GENRES" Style="{StaticResource InspectorSectionTitle}" Margin="0,17,0,8"/>
                                <TextBlock Text="Long-term identity. You can also say 'Thể loại: fantasy, romcom' in Chat." Foreground="{StaticResource StorySub}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <WrapPanel x:Name="NewStoryCoreGenresPanel"/>
                                <TextBlock Text="TEMPORARY TAGS" Style="{StaticResource InspectorSectionTitle}" Margin="0,16,0,8"/>
                                <TextBlock Text="Mood or subgenre for the current arc." Foreground="{StaticResource StorySub}" FontSize="11" Margin="0,0,0,10"/>
                                <WrapPanel x:Name="NewStoryTemporaryTagsPanel"/>
                            </StackPanel>
                            <Border Height="1" Background="{StaticResource StoryDivider}" Margin="0,17,0,16"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Width="88" Style="{StaticResource StoryButton}" Click="CancelNewStoryButton_Click"/>
                                <Button Content="Create Story" Width="116" Margin="8,0,0,0" Style="{StaticResource StoryAccentButton}" Click="CreateStoryInlineButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>

            <!-- Dynamic memory context strip, shown once a conversation exists. -->
            <Border x:Name="ContextBar" Grid.Row="1" Visibility="Collapsed" Height="36" Background="{StaticResource StorySurface}"
                    BorderBrush="{StaticResource StoryDivider}" BorderThickness="0,1,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="24,0" VerticalAlignment="Center">
                        <TextBlock Text="Context" Foreground="{StaticResource StoryMuted}" FontSize="10" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource StoryGhost}" BorderBrush="{StaticResource StoryDivider}" BorderThickness="1" CornerRadius="5" Padding="8,2" Margin="0,0,6,0"><TextBlock x:Name="ContextCharactersText" Foreground="{StaticResource StorySub}" FontSize="10.5"/></Border>
                        <Border Background="{StaticResource StoryGhost}" BorderBrush="{StaticResource StoryDivider}" BorderThickness="1" CornerRadius="5" Padding="8,2" Margin="0,0,6,0"><TextBlock x:Name="ContextCanonText" Foreground="{StaticResource StorySub}" FontSize="10.5"/></Border>
                        <Border Background="{StaticResource StoryGhost}" BorderBrush="{StaticResource StoryDivider}" BorderThickness="1" CornerRadius="5" Padding="8,2" Margin="0,0,6,0"><TextBlock x:Name="ContextTimelineText" Foreground="{StaticResource StorySub}" FontSize="10.5"/></Border>
                        <Border Background="{StaticResource StoryGhost}" BorderBrush="{StaticResource StoryDivider}" BorderThickness="1" CornerRadius="5" Padding="8,2" Margin="0,0,6,0"><TextBlock x:Name="ContextLoreText" Foreground="{StaticResource StorySub}" FontSize="10.5"/></Border>
                        <Border Background="{StaticResource StoryGhost}" BorderBrush="{StaticResource StoryDivider}" BorderThickness="1" CornerRadius="5" Padding="8,2"><TextBlock x:Name="ContextChaptersText" Foreground="{StaticResource StorySub}" FontSize="10.5"/></Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Figma-style large composer. -->
            <Border x:Name="ComposerShell" Grid.Row="2" Background="{StaticResource StoryComposer}" BorderBrush="{StaticResource StoryBorder}" BorderThickness="0,1,0,0" Padding="20,11,20,17">
                <StackPanel>
                    <ScrollViewer x:Name="SuggestionStrip" Visibility="Visible" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,9"
                                  PreviewMouseWheel="SuggestionStrip_PreviewMouseWheel">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Discuss ideas · Chat" Style="{StaticResource SuggestionChipButton}" Click="ClearStoryActionButton_Click" ToolTip="Talk through ideas with Gemini. Chat never commits a chapter by itself."/>
                            <Button Content="Scene Compass" Style="{StaticResource SuggestionChipButton}" Click="SceneCompassChip_Click" ToolTip="Preview committed chapter context and make an editable writing cue; no API call"/>
                            <Button Tag="ContinueStory" Content="Continue Story" Style="{StaticResource SuggestionChipButton}" Click="SuggestionCard_Click"/>
                            <Button Tag="DraftScene" Content="Draft Scene" Style="{StaticResource SuggestionChipButton}" Click="SuggestionCard_Click"/>
                            <Button Tag="PlanChapter" Content="Plan Chapter" Style="{StaticResource SuggestionChipButton}" Click="SuggestionCard_Click"/>
                            <Button Tag="BuildCharacter" Content="Build Character" Style="{StaticResource SuggestionChipButton}" Click="SuggestionCard_Click"/>
                            <Button Tag="CheckContinuity" Content="Check Continuity" Style="{StaticResource SuggestionChipButton}" Click="SuggestionCard_Click"/>
                            <Button Tag="ExpandLore" Content="Expand Lore" Style="{StaticResource SuggestionChipButton}" Click="SuggestionCard_Click"/>
                            <Button Tag="ReviseCanon" Content="Revise Canon" Style="{StaticResource SuggestionChipButton}" Click="SuggestionCard_Click"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Story Director is optional. Proposals are ephemeral, never canon. -->
                    <Border x:Name="DirectorPanel" Visibility="Collapsed" Background="{StaticResource StorySurface}"
                            BorderBrush="{StaticResource StoryGoldBorder}" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="STORY DIRECTOR · BEFORE YOU WRITE" Foreground="{StaticResource StoryGold}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="Choose a next-chapter direction, edit it, or let Gemini improvise. These are ideas, not canon."
                                       Foreground="{StaticResource StorySub}" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <Button x:Name="DirectorOptionA" Tag="A" Content="Direction A" Style="{StaticResource StoryButton}" Click="DirectorOption_Click" Margin="0,0,6,0"/>
                                <Button x:Name="DirectorOptionB" Tag="B" Content="Direction B" Style="{StaticResource StoryButton}" Click="DirectorOption_Click" Margin="0,0,6,0"/>
                                <Button x:Name="DirectorOptionC" Tag="C" Content="Direction C" Style="{StaticResource StoryButton}" Click="DirectorOption_Click"/>
                            </StackPanel>
                            <TextBox x:Name="DirectorReviewBox" Style="{StaticResource StoryTextBox}" AcceptsReturn="True" TextWrapping="Wrap"
                                     Height="112" MaxHeight="150" VerticalScrollBarVisibility="Auto"/>
                            <WrapPanel Margin="0,9,0,0">
                                <Button Content="Write with this direction" Style="{StaticResource StoryAccentButton}" Click="DirectorApprove_Click" Margin="0,0,7,4"/>
                                <Button Content="Write freely" Style="{StaticResource StoryButton}" Click="DirectorFreely_Click" Margin="0,0,7,4"/>
                                <Button Content="Discard" Style="{StaticResource StoryButton}" Click="DirectorDismiss_Click" Margin="0,0,7,4"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource StorySurface}" BorderBrush="{StaticResource StoryBorder}" BorderThickness="1" CornerRadius="14">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border x:Name="ActiveActionBar" Visibility="Collapsed" Margin="12,10,12,0" HorizontalAlignment="Left"
                                    Background="{StaticResource StoryGoldDim}" BorderBrush="{StaticResource StoryGoldBorder}" BorderThickness="1" CornerRadius="7" Padding="8,4,4,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ActiveActionText" Foreground="{StaticResource StoryGold}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Content="×" Width="24" Height="22" Margin="5,0,0,0" Padding="0" BorderThickness="0"
                                            Style="{StaticResource StoryButton}" ToolTip="Return to normal chat" Click="ClearStoryActionButton_Click"/>
                                </StackPanel>
                            </Border>
                            <Grid x:Name="ComposerInputHost" Grid.Row="1" MinHeight="92" MaxHeight="190">
                                <TextBox x:Name="InputBox" IsEnabled="False" MinHeight="92" MaxHeight="190" Padding="17,14" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="{StaticResource StoryText}"
                                         BorderThickness="0" CaretBrush="{StaticResource StoryGold}" FontSize="13.5"
                                         PreviewKeyDown="InputBox_PreviewKeyDown" TextChanged="InputBox_TextChanged"/>
                                <TextBlock x:Name="InputHintText" Text="Start a story to begin writing…" Foreground="{StaticResource StoryMuted}" FontSize="13.5"
                                           Margin="18,15,18,0" VerticalAlignment="Top" IsHitTestVisible="False" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Grid.Row="2" Margin="0" Height="48">
                                <Border Height="1" Background="{StaticResource StoryDivider}" VerticalAlignment="Top"/>
                                <Grid Margin="11,7,10,7">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox x:Name="RoleBox" Width="126" IsEnabled="False" Visibility="Visible" Style="{StaticResource StoryCombo}"
                                                  SelectionChanged="RoleBox_SelectionChanged" ToolTip="Role changes the AI tone (Companion discusses, Writer writes). Action controls what happens: Chat never commits chapters; Continue Story writes."/>
                                        <!-- Kept as collapsed named controls so existing state/update code remains stable; Story Settings now owns these actions. -->
                                        <Button x:Name="ProviderButton" Visibility="Collapsed" IsHitTestVisible="False"/>
                                        <Button x:Name="MemoryButton" Visibility="Collapsed" IsHitTestVisible="False"/>
                                        <Button x:Name="GenresButton" Visibility="Collapsed" IsHitTestVisible="False"/>
                                    </StackPanel>
                                    <TextBlock x:Name="StatusText" Grid.Column="1" Visibility="Collapsed" Foreground="{StaticResource StoryMuted}" FontSize="10.5"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="StopButton" Content="Stop" Width="62" Margin="0,0,7,0" Visibility="Collapsed"
                                                Style="{StaticResource StoryButton}" Background="#2A1B18" BorderBrush="#5D352D" Click="StopButton_Click"/>
                                        <Button x:Name="SendButton" Content="Send  ➤" Width="92" IsEnabled="False" Style="{StaticResource StoryAccentButton}" Click="SendButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="InspectorPanel" Grid.Column="2" Visibility="Collapsed" Background="#12100E" BorderBrush="{StaticResource StoryBorder}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="18,0,12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="InspectorTitle" Text="Story details" Foreground="{StaticResource StoryText}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="InspectorSubtitle" Foreground="{StaticResource StoryMuted}" FontSize="10.5" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="×" Width="32" Height="32" Style="{StaticResource StoryButton}" BorderThickness="0" FontSize="18" ToolTip="Close panel" Click="CloseInspectorButton_Click"/>
                    <Border Grid.ColumnSpan="2" Height="1" Background="{StaticResource StoryDivider}" VerticalAlignment="Bottom"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="18,18,18,24">
                        <StackPanel x:Name="InspectorMemoryView">
                            <Border Background="#191612" BorderBrush="#44391F" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel>
                                    <TextBlock x:Name="InspectorMemoryHeading" Foreground="{StaticResource StoryGold}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="InspectorMemoryBodyText" Foreground="#D8CFBC" FontSize="11.5" TextWrapping="Wrap" Margin="0,9,0,0" LineHeight="19"/>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="InspectorIdeasToolbar" Visibility="Collapsed" Margin="0,14,0,0">
                                <TextBox x:Name="InspectorIdeaSearch" Style="{StaticResource StoryTextBox}"
                                         ToolTip="Find saved directions without changing canon or chat history"
                                         TextChanged="InspectorIdeaSearch_TextChanged" MaxLength="120"
                                         MinHeight="32" VerticalContentAlignment="Center"/>
                                <Grid Margin="0,8,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="InspectorIdeaStatus" Style="{StaticResource StoryCombo}" MinHeight="30"
                                              SelectionChanged="InspectorIdeaFilter_Changed" ToolTip="Filter by decision status"/>
                                    <ComboBox x:Name="InspectorIdeaCategory" Grid.Column="2" Style="{StaticResource StoryCombo}" MinHeight="30"
                                              SelectionChanged="InspectorIdeaFilter_Changed" ToolTip="Filter by author-assigned category"/>
                                </Grid>
                                <TextBlock x:Name="InspectorIdeaCount" FontSize="10" Foreground="{StaticResource StoryMuted}"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel x:Name="InspectorIdeasList" Visibility="Collapsed" Margin="0,9,0,0"/>
                            <Button x:Name="SceneCompassUseCueButton" Content="Use as editable Continue Story cue" Visibility="Collapsed"
                                    Style="{StaticResource StoryAccentButton}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                    Click="SceneCompassUseCue_Click" ToolTip="Copies a suggestion into the composer; does not send, write or commit"/>
                            <WrapPanel x:Name="InspectorMemoryActions" Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="InspectorAutoBookkeepingButton" Content="Auto-bookkeeping" Style="{StaticResource StoryButton}" Click="InspectorAutoBookkeepingButton_Click"/>
                                <Button x:Name="InspectorApproveButton" Content="Approve proposed" Margin="6,0,0,0" Style="{StaticResource StoryButton}" Click="InspectorApproveButton_Click"/>
                                <Button x:Name="InspectorDiscardButton" Content="Discard proposed" Margin="6,0,0,0" Style="{StaticResource StoryButton}" Click="InspectorDiscardButton_Click"/>
                            </WrapPanel>
                            <Expander x:Name="InspectorVersionExpander" Header="STORY BRANCHES / VERSIONS" Margin="0,14,0,0" Foreground="{StaticResource StoryGold}" Expanded="InspectorVersionExpander_Expanded" Visibility="Collapsed">
                                <StackPanel x:Name="InspectorCheckpointList" Margin="4,12,4,3"/>
                            </Expander>
                        </StackPanel>

                        <StackPanel x:Name="InspectorSettingsView" Visibility="Collapsed">
                            <TextBlock Text="STORY GENRES" Style="{StaticResource InspectorSectionTitle}"/>
                            <TextBlock Text="Core genres define the story's long-term identity. Temporary tags can shift by scene, chapter, or arc." Foreground="{StaticResource StorySub}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,11"/>
                            <TextBlock Text="CORE GENRES" Foreground="{StaticResource StoryMuted}" FontSize="9.5" FontWeight="SemiBold" Margin="0,0,0,7"/>
                            <WrapPanel x:Name="SettingsCoreGenresPanel"/>
                            <TextBlock Text="TEMPORARY TAGS" Foreground="{StaticResource StoryMuted}" FontSize="9.5" FontWeight="SemiBold" Margin="0,13,0,7"/>
                            <WrapPanel x:Name="SettingsTemporaryTagsPanel"/>

                            <Border Height="1" Background="{StaticResource StoryDivider}" Margin="0,18"/>
                            <TextBlock Text="CONTINUE STORY AUTONOMY" Style="{StaticResource InspectorSectionTitle}"/>
                            <TextBlock Text="Controls how much initiative AI takes when you use Continue Story. Other explicit Story Actions keep their own workflow." Foreground="{StaticResource StorySub}" FontSize="11" Margin="0,0,0,9" TextWrapping="Wrap"/>
                            <ComboBox x:Name="SettingsAutonomyBox" Style="{StaticResource StoryCombo}" SelectionChanged="SettingsAutonomyBox_SelectionChanged"/>
                            <TextBlock x:Name="SettingsAutonomyDescriptionText" Foreground="{StaticResource StoryMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"/>

                            <Border Height="1" Background="{StaticResource StoryDivider}" Margin="0,18"/>
                            <TextBlock Text="STORY DIRECTOR" Style="{StaticResource InspectorSectionTitle}"/>
                            <TextBlock Text="Off: Continue Story runs normally. Review: preview three possible directions and choose/edit one before writing. Chat stays discussion-only; proposals never become canon." Foreground="{StaticResource StorySub}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,9"/>
                            <ComboBox x:Name="SettingsDirectorBox" Style="{StaticResource StoryCombo}" SelectionChanged="SettingsDirectorBox_SelectionChanged"/>
                            <TextBlock Text="NARRATIVE FOCUS" Foreground="{StaticResource StoryMuted}" FontSize="9.5" FontWeight="SemiBold" Margin="0,13,0,7"/>
                            <ComboBox x:Name="SettingsNarrativeFocusBox" Style="{StaticResource StoryCombo}" SelectionChanged="SettingsNarrativeFocusBox_SelectionChanged"/>
                            <TextBlock Text="CREATIVE STEERING · optional" Foreground="{StaticResource StoryMuted}" FontSize="9.5" FontWeight="SemiBold" Margin="0,13,0,7"/>
                            <TextBlock Text="e.g. Avoid introducing new factions; slow romance and let characters face the last chapter's consequences. Never treated as a confirmed event." Foreground="{StaticResource StorySub}" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBox x:Name="SettingsNarrativeGuardrailsBox" Style="{StaticResource StoryTextBox}" MaxLength="480" AcceptsReturn="True" TextWrapping="Wrap"
                                     Height="70" VerticalScrollBarVisibility="Auto"/>
                            <Button Content="Save direction" Style="{StaticResource StoryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="SaveNarrativeGuardrails_Click"/>

                            <Border Height="1" Background="{StaticResource StoryDivider}" Margin="0,18"/>
                            <TextBlock Text="MANUSCRIPT" Style="{StaticResource InspectorSectionTitle}"/>
                            <TextBlock Text="Choose whether generated narrative becomes story truth immediately or waits for your approval." Foreground="{StaticResource StorySub}" FontSize="11" Margin="0,0,0,9" TextWrapping="Wrap"/>
                            <ComboBox x:Name="SettingsManuscriptModeBox" Style="{StaticResource StoryCombo}" SelectionChanged="SettingsManuscriptModeBox_SelectionChanged"/>
                            <TextBlock x:Name="SettingsManuscriptDescriptionText" Foreground="{StaticResource StoryMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"/>

                            <Border Height="1" Background="{StaticResource StoryDivider}" Margin="0,18"/>
                            <TextBlock Text="CONTENT PROFILE" Style="{StaticResource InspectorSectionTitle}"/>
                            <TextBlock Text="Sets the intended maturity and intensity for this story. It guides tone; it does not override provider/platform limits." Foreground="{StaticResource StorySub}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <TextBlock Text="Maturity" Foreground="{StaticResource StorySub}" FontSize="10.5" Margin="0,0,0,5"/>
                            <ComboBox x:Name="SettingsMaturityBox" Style="{StaticResource StoryCombo}"/>
                            <TextBlock Text="Violence / gore" Foreground="{StaticResource StorySub}" FontSize="10.5" Margin="0,12,0,5"/>
                            <ComboBox x:Name="SettingsViolenceBox" Style="{StaticResource StoryCombo}"/>
                            <TextBlock Text="Horror intensity" Foreground="{StaticResource StorySub}" FontSize="10.5" Margin="0,12,0,5"/>
                            <ComboBox x:Name="SettingsHorrorBox" Style="{StaticResource StoryCombo}"/>
                            <TextBlock Text="Intimacy boundary" Foreground="{StaticResource StorySub}" FontSize="10.5" Margin="0,12,0,5"/>
                            <ComboBox x:Name="SettingsIntimacyBox" Style="{StaticResource StoryCombo}"/>
                            <TextBlock Text="Sensitive-theme notes" Foreground="{StaticResource StorySub}" FontSize="10.5" Margin="0,12,0,5"/>
                            <TextBox x:Name="SettingsContentNotesBox" Style="{StaticResource StoryTextBox}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="120" VerticalScrollBarVisibility="Auto"/>
                            <Button Content="Save content profile" MinWidth="132" HorizontalAlignment="Left" Margin="0,10,0,0" Style="{StaticResource StoryButton}" Click="SaveContentProfileButton_Click"/>

                            <Border Height="1" Background="{StaticResource StoryDivider}" Margin="0,18"/>
                            <TextBlock Text="AI CONNECTION" Style="{StaticResource InspectorSectionTitle}"/>
                            <TextBlock x:Name="SettingsConnectionStatusText" Foreground="{StaticResource StorySub}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <TextBlock Text="Provider" Foreground="{StaticResource StorySub}" FontSize="10.5" Margin="0,0,0,5"/>
                            <ComboBox x:Name="SettingsProviderBox" Style="{StaticResource StoryCombo}" SelectionChanged="SettingsProviderBox_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Model" Foreground="{StaticResource StorySub}" FontSize="10.5" Margin="0,12,0,5"/>
                            <TextBox x:Name="SettingsModelBox" Style="{StaticResource StoryTextBox}"/>
                            <TextBlock Text="API key" Foreground="{StaticResource StorySub}" FontSize="10.5" Margin="0,12,0,5"/>
                            <PasswordBox x:Name="SettingsApiKeyBox" Height="38" Padding="10,7" Background="#181511" Foreground="{StaticResource StoryText}" BorderBrush="#514425" BorderThickness="1"/>
                            <TextBlock Text="Keys stay encrypted for your Windows account with DPAPI. Leave blank to keep the saved key." Foreground="{StaticResource StoryMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                                <Button Content="Save AI" Width="82" Style="{StaticResource StoryAccentButton}" Click="SaveInspectorAiButton_Click"/>
                                <Button x:Name="ClearInspectorKeyButton" Content="Clear key" Width="82" Margin="7,0,0,0" Style="{StaticResource StoryButton}" Click="ClearInspectorKeyButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
