<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Quiet Workbench / Impeccable-informed design pass: functional contrast, no decoration. -->
    <SolidColorBrush x:Key="ShellCanvasBrush" Color="#0E1315"/>
    <SolidColorBrush x:Key="ShellSurfaceBrush" Color="#171D20"/>
    <SolidColorBrush x:Key="ShellElevatedBrush" Color="#20282B"/>
    <SolidColorBrush x:Key="ShellHoverBrush" Color="#293337"/>
    <SolidColorBrush x:Key="ShellLineBrush" Color="#303B3E"/>
    <SolidColorBrush x:Key="ShellAccentBrush" Color="#A5DDC8"/>
    <SolidColorBrush x:Key="ShellAccentSoftBrush" Color="#203D38"/>
    <SolidColorBrush x:Key="ShellTextBrush" Color="#F1F3F0"/>
    <SolidColorBrush x:Key="ShellMutedBrush" Color="#ADB8B6"/>
    <SolidColorBrush x:Key="ShellPositiveBrush" Color="#89DAB6"/>
    <SolidColorBrush x:Key="ShellDangerBrush" Color="#F2A0A0"/>
    <!-- Flat rail keeps pixel icons crisp; gradients are intentionally absent. -->
    <SolidColorBrush x:Key="ShellChromeGradientBrush" Color="#12191B"/>
</ResourceDictionary>
