<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- WorkChat Core 2.48: lightweight Fluent-inspired design tokens. -->
    <SolidColorBrush x:Key="ShellCanvasBrush" Color="#0B1020"/>
    <SolidColorBrush x:Key="ShellSurfaceBrush" Color="#121B2D"/>
    <SolidColorBrush x:Key="ShellElevatedBrush" Color="#19253A"/>
    <SolidColorBrush x:Key="ShellHoverBrush" Color="#263854"/>
    <SolidColorBrush x:Key="ShellLineBrush" Color="#2B3C56"/>
    <SolidColorBrush x:Key="ShellAccentBrush" Color="#86A7FF"/>
    <SolidColorBrush x:Key="ShellAccentSoftBrush" Color="#23385C"/>
    <SolidColorBrush x:Key="ShellTextBrush" Color="#F6F8FF"/>
    <SolidColorBrush x:Key="ShellMutedBrush" Color="#B2C0D6"/>
    <LinearGradientBrush x:Key="ShellChromeGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#151D30"/>
        <GradientStop Offset="1" Color="#101A2C"/>
    </LinearGradientBrush>
</ResourceDictionary>
